{
  "manifest_version": 3,
  "name": "Cognify – YouTube Focus & Playback Controls",
  "version": "3.9.0",
  "description": "YouTube playback controls, bookmarks, focus tools, screen-time limits, and watch statistics.",
  "author": "Mahmud Nibir",
  "homepage_url": "https://github.com/mahmudnibir/yt-extension-enhanced",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://www.youtube.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/edge-hud.js", "src/content.js", "src/download.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16":  "icons/icon-16.png",
      "48":  "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      }
    }
  },
  "icons": {
    "16":  "icons/icon-16.png",
    "48":  "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "src/background.js"
  }
}
